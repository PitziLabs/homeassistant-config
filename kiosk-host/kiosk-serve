#!/usr/bin/env bash
# kiosk-serve — put a page on pve2's office monitor, then snapshot it.
# The "show me a diagram" sibling to kiosk-preview (which is specialised to
# dashboard YAML). Runs from your workstation (NOT deployed to pve2).
#
# What it does:
#   1. Pushes content to /opt/claude-kiosk on pve2 — either a tagged page
#      from the in-repo library (pages/), or an ad-hoc local file/dir.
#   2. Serves it with a transient systemd unit (claude-kiosk-www) on $PORT,
#      bound so Chromium reaches it at http://localhost:$PORT/.
#   3. Points the kiosk at it. If the kiosk is already on that URL, refreshes
#      with F5 (fast, no relaunch) instead of a full kiosk-show restart.
#   4. Ensures the snapshot server is up and grabs ./kiosk-serve-<UTC>.png so
#      you can SEE what rendered (Mermaid/WebGL render client-side).
#
# Library pages (pages/) carry vendored assets (assets/mermaid.min.js) so they
# render offline with no CDN round-trip. List them with --list.
#
# Usage:
#   kiosk-serve --page NAME          Serve a tagged library page (arch/network/obs/...).
#   kiosk-serve --list               List the library pages and aliases.
#   kiosk-serve PAGE.html            Ad-hoc: push a single local file as index.html.
#   kiosk-serve DIR/                 Ad-hoc: serve a directory (needs index.html).
#   kiosk-serve --snapshot           Just grab the current frame (no push).
#   kiosk-serve --dashboard          Snap the kiosk back to the HA dashboard.
#   kiosk-serve --stop               Snap back AND stop the web server.
#   kiosk-serve --show               Print kiosk + web-server state.
#
# Options:
#   --port N        Web-server port (default 8088).
#   --settle SECS   Wait before snapshot (default 7; bump for heavy WebGL).
#   --no-snapshot   Skip the snapshot step.
#   --open          xdg-open the captured PNG.
set -euo pipefail

readonly REMOTE="root@pve2"
readonly JUMP="root@pve.local"
SSH=(ssh -J "$JUMP" -o ConnectTimeout=4 -o BatchMode=yes "$REMOTE")

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
readonly SCRIPT_DIR
readonly PAGES_DIR="${SCRIPT_DIR}/pages"
readonly LIBRARY="${PAGES_DIR}/library.json"

readonly CONTENT_DIR="/opt/claude-kiosk"
readonly WWW_UNIT="claude-kiosk-www"
readonly SNAP_UNIT="snapshot-server.service"
readonly SNAP_PORT=9999

PORT=8088
SETTLE=7
DO_SNAPSHOT=1
DO_OPEN=0
ACTION=""        # serve | page | list | snapshot | dashboard | stop | show
TARGET=""        # local file or dir for ad-hoc serve
PAGE_NAME=""
URL=""           # set before point_kiosk()

die() { echo "kiosk-serve: $*" >&2; exit 1; }
usage() { sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; }

# ---- arg parse --------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --page)       ACTION=page; PAGE_NAME="${2:?--page needs a NAME}"; shift ;;
    --list)       ACTION=list ;;
    --snapshot)   ACTION=snapshot ;;
    --dashboard)  ACTION=dashboard ;;
    --stop)       ACTION=stop ;;
    --show)       ACTION=show ;;
    --open)       DO_OPEN=1 ;;
    --no-snapshot) DO_SNAPSHOT=0 ;;
    --port)       PORT="${2:?--port needs a value}"; shift ;;
    --settle)     SETTLE="${2:?--settle needs a value}"; shift ;;
    -h|--help)    usage; exit 0 ;;
    -*)           die "unknown option: $1" ;;
    *)            TARGET="$1"; ACTION="${ACTION:-serve}" ;;
  esac
  shift
done
[[ -z "$ACTION" ]] && { usage; exit 0; }

# ---- library helpers --------------------------------------------------------
resolve_page() {
  # name-or-alias → filename (on stdout), or die.
  [[ -f "$LIBRARY" ]] || die "library manifest not found: $LIBRARY"
  local file
  if ! file=$(python3 - "$LIBRARY" "$1" <<'PY'
import json, sys
lib = json.load(open(sys.argv[1])); name = sys.argv[2]
if name in lib:
    print(lib[name]["file"]); sys.exit(0)
for v in lib.values():
    if name in v.get("aliases", []):
        print(v["file"]); sys.exit(0)
sys.exit(1)
PY
  ); then
    die "unknown page '$1' — try: kiosk-serve --list"
  fi
  [[ -f "${PAGES_DIR}/${file}" ]] || die "manifest points at a missing file: ${file}"
  printf '%s' "$file"
}

list_pages() {
  [[ -f "$LIBRARY" ]] || die "library manifest not found: $LIBRARY"
  echo "Library pages (kiosk-serve --page NAME):"
  python3 - "$LIBRARY" <<'PY'
import json, sys
lib = json.load(open(sys.argv[1]))
w = max(len(k) for k in lib)
for k, v in lib.items():
    al = v.get("aliases", [])
    tail = f"   aliases: {', '.join(al)}" if al else ""
    print(f"  {k.ljust(w)}  {v['title']}{tail}")
PY
}

# ---- remote helpers ---------------------------------------------------------
push_dir() {  # $1 = local dir
  tar -C "$1" -czf - . | "${SSH[@]}" \
    "rm -rf ${CONTENT_DIR}; mkdir -p ${CONTENT_DIR}; tar -C ${CONTENT_DIR} -xzf -"
}
push_file() { # $1 = local file → index.html
  "${SSH[@]}" "mkdir -p ${CONTENT_DIR}; rm -rf ${CONTENT_DIR:?}/*; cat > ${CONTENT_DIR}/index.html" < "$1"
}
start_www() {
  # Restarting the web server does NOT restart Chromium (no flicker); it only
  # re-binds the port and serves the fresh content dir.
  "${SSH[@]}" "
    systemctl reset-failed ${WWW_UNIT}.service 2>/dev/null || true
    systemctl stop ${WWW_UNIT}.service 2>/dev/null || true
    systemd-run --unit=${WWW_UNIT} --collect \
      /usr/bin/python3 -m http.server ${PORT} --bind 0.0.0.0 --directory ${CONTENT_DIR} >/dev/null
    echo 'kiosk-serve: serving ${CONTENT_DIR} on :${PORT}'
  "
}
point_kiosk() {  # uses global $URL
  local current
  current=$("${SSH[@]}" "kiosk-show --show 2>/dev/null | sed -n 's/^KIOSK_URL=//p'" || true)
  if [[ "$current" == "$URL" ]]; then
    echo "kiosk-serve: already on ${URL} — refreshing (F5)"
    "${SSH[@]}" "DISPLAY=:0 XAUTHORITY=/root/.Xauthority xdotool key F5" || true
  else
    "${SSH[@]}" "kiosk-show --kiosk '${URL}'"
  fi
}
snapshot() {
  # Fetched THROUGH the ssh jump (curl on pve2 → stdout), so it never depends
  # on workstation→pve2 routing/mDNS. Re-ensure the server is up first.
  local out; out="kiosk-serve-$(date -u +%Y%m%dT%H%M%SZ).png"
  "${SSH[@]}" "systemctl is-active --quiet ${SNAP_UNIT} || systemctl start ${SNAP_UNIT}" 2>/dev/null || true
  if "${SSH[@]}" "curl -fsS http://localhost:${SNAP_PORT}/" > "$out" 2>/dev/null && [[ -s "$out" ]]; then
    echo "kiosk-serve: snapshot → ${out} ($(stat -c%s "$out") bytes)"
    [[ "$DO_OPEN" == 1 ]] && command -v xdg-open >/dev/null && xdg-open "$out" >/dev/null 2>&1 || true
  else
    rm -f "$out"
    echo "kiosk-serve: snapshot failed (is snapshot-server healthy on pve2?)" >&2
  fi
}

# ---- actions ----------------------------------------------------------------
case "$ACTION" in
  list)
    list_pages
    ;;
  show)
    "${SSH[@]}" "kiosk-show --show; echo '--- web server ---'; systemctl is-active ${WWW_UNIT}.service 2>/dev/null || echo 'claude-kiosk-www: inactive'"
    ;;
  dashboard)
    "${SSH[@]}" "kiosk-show --dashboard"
    ;;
  stop)
    "${SSH[@]}" "kiosk-show --dashboard; systemctl stop ${WWW_UNIT}.service 2>/dev/null; systemctl reset-failed ${WWW_UNIT}.service 2>/dev/null; rm -rf ${CONTENT_DIR}; echo 'kiosk-serve: stopped web server, snapped back to dashboard'"
    ;;
  snapshot)
    snapshot
    ;;
  page)
    file=$(resolve_page "$PAGE_NAME")
    echo "kiosk-serve: page '${PAGE_NAME}' → ${file}"
    push_dir "$PAGES_DIR"
    start_www
    URL="http://localhost:${PORT}/${file}"
    point_kiosk
    [[ "$DO_SNAPSHOT" == 1 ]] && { sleep "$SETTLE"; snapshot; }
    ;;
  serve)
    [[ -e "$TARGET" ]] || die "no such file or directory: $TARGET"
    if [[ -d "$TARGET" ]]; then
      [[ -f "$TARGET/index.html" ]] || die "directory has no index.html: $TARGET"
      push_dir "$TARGET"
    else
      [[ "$TARGET" == *.html ]] || echo "kiosk-serve: note — serving '${TARGET##*/}' as index.html" >&2
      push_file "$TARGET"
    fi
    start_www
    URL="http://localhost:${PORT}/"
    point_kiosk
    [[ "$DO_SNAPSHOT" == 1 ]] && { sleep "$SETTLE"; snapshot; }
    ;;
esac
